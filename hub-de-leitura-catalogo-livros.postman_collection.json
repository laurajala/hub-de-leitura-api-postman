      "name": "00 - Login Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();\r",
              "\r",
              "pm.test(\"Status code é 200\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Usuário logado é administrador\", () => {\r",
              "    pm.expect(res.isAdmin).to.eql(true);\r",
              "    pm.expect(res.email).to.eql(\"admin@biblioteca.com\");\r",
              "});\r",
              "\r",
              "pm.test(\"Token retornado no formato Bearer\", () => {\r",
              "    pm.expect(res.token).to.be.a(\"string\");\r",
              "    pm.expect(res.token).to.include(\"Bearer \");\r",
              "});\r",
              "\r",
              "// Salva o token para ser usado nas próximas requisições\r",
              "pm.collectionVariables.set(\"tokenAdmin\", res.token);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
