              "\r",
              "pm.test(\"Livro retornado é o mesmo que foi cadastrado\", () => {\r",
              "    pm.expect(res.book.id).to.eql(idEsperado);\r",
              "    pm.expect(res.book.title).to.eql(tituloEsperado);\r",
              "    pm.expect(res.book.author).to.eql(\"Laura Ajala QA\");\r",
              "});\r",
              "\r",
              "pm.test(\"Livro está disponível para reserva\", () => {\r",
              "    pm.expect(res.availability.total_copies).to.eql(3);\r",
              "    pm.expect(res.availability.available_copies).to.eql(3);\r",
              "    pm.expect(res.availability.isAvailable).to.eql(true);\r",
              "});"
