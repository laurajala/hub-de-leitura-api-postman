              "});\r",
              "\r",
              "pm.test(\"Mensagem informa que o livro já existe\", () => {\r",
              "    pm.expect(res.message).to.eql(\"Já existe um livro com este título e autor.\");\r",
              "});\r",
              "\r",
              "pm.test(\"API retorna os dados do livro já cadastrado\", () => {\r",
              "    pm.expect(res.existingBook.title).to.eql(tituloExistente);\r",
              "    pm.expect(res.existingBook.author).to.eql(autorExistente);\r",
              "    pm.expect(res.existingBook.id).to.be.a(\"number\");\r",
              "});\r",
              "\r",
              "pm.test(\"Nenhum livro novo é criado\", () => {\r",
              "    pm.expect(res).to.not.have.property(\"book\");\r",
              "});"
