    {
      "name": "CT01 - Listar livros",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();\r",
              "\r",
              "pm.test(\"Status code é 200\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Resposta contém a lista de livros\", () => {\r",
              "    pm.expect(res.books).to.be.an(\"array\");\r",
              "    pm.expect(res.books.length).to.be.above(0);\r",
              "});\r",
              "\r",
              "pm.test(\"Cada livro possui título e autor\", () => {\r",
              "    res.books.forEach(livro => {\r",
              "        pm.expect(livro).to.have.property(\"title\");\r",
              "        pm.expect(livro).to.have.property(\"author\");\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"Paginação retornada corretamente\", () => {\r",
              "    pm.expect(res.pagination.total).to.be.above(0);\r",
              "    pm.expect(res.pagination.showing).to.eql(res.books.length);\r",
              "});\r",
              "\r",
              "// Guarda um livro existente para o cenário de duplicidade (CT10)\r",
              "pm.collectionVariables.set(\"existingTitle\", res.books[0].title);\r",
              "pm.collectionVariables.set(\"existingAuthor\", res.books[0].author);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "books"
          ]
        }
      },
      "response": []
    },
    {
      "name": "CT02 - Cadastrar livro válido",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Gera um título único a cada execução para evitar a regra de duplicidade\r",
              "const titulo = \"Livro QA \" + Date.now();\r",
              "pm.collectionVariables.set(\"bookTitle\", titulo);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();\r",
              "const tituloEnviado = pm.collectionVariables.get(\"bookTitle\");\r",
              "\r",
              "pm.test(\"Status code é 201\", () => {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"Mensagem de sucesso retornada\", () => {\r",
              "    pm.expect(res.message).to.eql(\"Livro criado com sucesso.\");\r",
              "});\r",
              "\r",
              "pm.test(\"Livro criado com os dados enviados\", () => {\r",
              "    pm.expect(res.book.title).to.eql(tituloEnviado);\r",
              "    pm.expect(res.book.author).to.eql(\"Laura Ajala QA\");\r",
              "    pm.expect(res.book.category).to.eql(\"Tecnologia\");\r",
              "});\r",
              "\r",
              "pm.test(\"Exemplares disponíveis iguais ao total cadastrado\", () => {\r",
              "    pm.expect(res.book.total_copies).to.eql(3);\r",
              "    pm.expect(res.book.available_copies).to.eql(3);\r",
              "});\r",
              "\r",
              "// Salva o ID para os próximos cenários (consultar, atualizar e excluir)\r",
              "pm.collectionVariables.set(\"bookId\", res.book.id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "{{tokenAdmin}}",
            "type": "text"
          }
